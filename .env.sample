# Configuration for github-backup.sh
# Copy to .env and fill in. .env is sourced by bash, so keep to KEY="value" lines.

# Your GitHub Username or Organization Name
GITHUB_ENTITY="github_username_or_organization"

# Your GitHub Personal Access Token (PAT) - Must have 'repo' scope
GITHUB_TOKEN="your_github_personal_access_token"

# Forks are skipped unless their upstream owner is listed here (space-separated,
# case-insensitive). Leave empty to back up no forks.
# sm6350-mainline is left out on purpose: its linux fork is ~6 GB.
FORK_INCLUDE_OWNERS="omacom wealthfolio xbow-engineering basecamp mmistakes SimonSchubert wmbusmeters Appdynamics fox-it dirkjanm zuidwijk mwgielen yunzheng thomasfaingnaert dstotijn"

# Base URL for the destination server.
DEST_URL_BASE="https://your-new-git-server.com/path/to/repos"

# Optional: where the timestamped *_backups directories are created.
# Defaults to the directory containing github-backup.sh.
# BACKUP_ROOT="/path/to/backups"
